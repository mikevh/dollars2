# Copy to .env and fill in real values. .env is gitignored (see *.env rule).

# SQL Server connection string for the existing MSSQL instance on your LAN.
# Do not use "localhost" - containers can't reach the host via localhost.
ConnectionStrings__DefaultConnection=Server=<lan-ip-or-hostname>;Database=Dollars2;User Id=<user>;Password=<password>;TrustServerCertificate=True;

# Random secret used to sign JWTs (e.g. `openssl rand -base64 48`)
Jwt__Secret=

# Origin the frontend is served from, e.g. your Tailscale hostname/IP + frontend https port.
# Must be https: passkeys (WebAuthn) require a secure context. Requires certs/claw.crt and
# certs/claw.key to exist (see E:\ca\claw-cert-notes.md on the CA host) — docker-compose.yml
# mounts them into both the frontend and backend containers.
Cors__FrontendUrl=https://<tailscale-host>:8443

# WebAuthn relying party ID for passkeys: bare hostname only, no scheme or port. Must match the
# host the browser sees when it registers/uses a passkey. Leave unset for local dev (falls back to
# the request's host header).
Identity__ServerDomain=<tailscale-host>

# App-wide Serilog minimum level. One of: Verbose, Debug, Information, Warning, Error, Fatal.
# Defaults to Information if unset. (Microsoft.AspNetCore stays pinned at Warning regardless.)
Serilog__MinimumLevel=Information

Plaid__ClientId=
Plaid__Secret=

# Backend origin the frontend's built JS will call - baked in at build time. Must be https, same
# reason as Cors__FrontendUrl above (a http fetch from a https page is blocked as mixed content).
VITE_API_BASE_URL=https://<tailscale-host>:5063
